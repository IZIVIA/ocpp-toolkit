{
    "$schema": "http://json-schema.org/draft-04/schema#",
    "title": "MeterValuesRequest",
    "type": "object",
    "properties": {
        "connectorId": {
            "type": "integer"
        },
        "values": {
            "type": "array",
            "items": {
                "type": "object",
                "properties": {
                    "timestamp": {
                        "type": "string",
                        "format": "date-time"
                    },
                    "value": {
                        "type": "integer"
                    }
                },
                "additionalProperties": false,
                "required": [
                    "timestamp",
                    "value"
                ]
            }
        }
    },
    "additionalProperties": false,
    "required": [
        "connectorId"
    ]
}
